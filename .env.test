DATABASE_URL="postgresql://mop_dev:mop_dev_secret@localhost:5432/mop_platform_test?schema=public&connect_timeout=10&pool_timeout=10"
# The integration suite legitimately logs in many times from one address.
# Production defaults (10/min) would make those tests fail for the wrong
# reason. Throttling itself is proven by auth/throttle.integration.spec.ts,
# which sets its own strict limit.
THROTTLE_AUTH_LIMIT=1000
THROTTLE_GLOBAL_LIMIT=10000
