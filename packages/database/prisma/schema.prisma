generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum AccountType {
  PLATFORM
  TENANT_STAFF
  CUSTOMER
  SYSTEM_AUTOMATION
}

enum AccountStatus {
  INVITED
  ACTIVE
  LOCKED
  SUSPENDED
  INACTIVE
}

enum TenantStatus {
  ACTIVE
  TRIAL
  PENDING_SETUP
  FROZEN
  SUSPENDED
  READ_ONLY
  ARCHIVED
}

enum StaffRole {
  TENANT_OWNER
  TENANT_ADMIN
  BRANCH_MANAGER
  TECHNICIAN
  INVENTORY_MANAGER
  TEAM_LEADER
  DATA_ANALYST
}

enum AnalystSavedViewSourcePage {
  OPERATIONS
  PEOPLE
  INVENTORY
  DECISIONS
  FEATURE_ADOPTION
}

enum CustomerPortalStatus {
  NOT_INVITED
  INVITED
  ENABLED
  DISABLED
}

enum CategoryCode {
  CARS
  MOTORCYCLES
  HEAVY_EQUIPMENT
}

// 16 states, authored directly from docs/PRODUCT_SPEC_CANONICAL.md's
// "CORE WORK ORDER LIFECYCLE" list. The old schema was missing 6 of these.
enum WorkOrderStatus {
  DRAFT
  REGISTERED
  UNDER_INSPECTION
  AWAITING_CUSTOMER_APPROVAL
  APPROVED_FOR_WORK
  IN_PROGRESS
  WAITING_PARTS
  WAITING_CUSTOMER
  BLOCKED
  READY_FOR_TEAM_REVIEW
  READY_FOR_QC
  QC_FAILED
  READY_FOR_DELIVERY
  PAYMENT_PENDING
  CLOSED
  CANCELLED
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  READY_FOR_REVIEW
  RETURNED_FOR_REWORK
  DONE
  CANCELLED
}

enum QcFailureReason {
  WORKMANSHIP
  INCOMPLETE_REPAIR
  INCORRECT_DIAGNOSIS
  DEFECTIVE_PART
  SAFETY_ISSUE
  DOCUMENTATION
  OTHER
}

enum TaskReworkReason {
  WORKMANSHIP
  INCOMPLETE_WORK
  INCORRECT_PROCEDURE
  DEFECTIVE_PART
  FAILED_INSPECTION
  CUSTOMER_COMPLAINT
  OTHER
}

enum BlockerReason {
  WAITING_PART
  WAITING_CUSTOMER
  NEED_TEAM_LEADER
  TOOL_MISSING
  SAFETY_ISSUE
  UNCLEAR_DIAGNOSIS
  OTHER
}

enum BlockerStatus {
  OPEN
  ESCALATED
  RESOLVED
}

enum InspectionType {
  QUICK
  FULL
}

// Shared 4-level scale used for both fault severity and customer decision
// item importance -- the spec treats these as the same concept.
enum SeverityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// 19 states. Adds RETURN_CLARIFICATION_REQUESTED, which the gap analysis
// found missing (spec's "Request Clarification" action on Returns/Movements
// had no backing state in the old build).
enum PartRequestStatus {
  DRAFT
  REQUESTED
  WAREHOUSE_REVIEWING
  APPROVED
  ISSUED
  IN_TRANSIT
  ARRIVED
  RECEIVED_BY_TECHNICIAN
  USED
  REJECTED
  UNAVAILABLE
  WAITING_TRANSFER
  WAITING_SUPPLIER
  RETURN_REQUESTED
  RETURN_ACCEPTED
  RETURNED_TO_STOCK
  RETURN_REJECTED
  RETURN_CLARIFICATION_REQUESTED
  CANCELLED
}

// Where a part on a work order came from. The reason this exists:
// a customer who brings their own part and pays only for fitting cannot be
// modelled as an inventory item priced at zero. There is no stock movement,
// no cost to the workshop, and -- decisively -- a different liability
// position, because warranty disputes turn on who supplied the part.
enum PartProvenance {
  // Issued from the workshop's own stock. Has a PartRequest.
  INVENTORY
  // Bought in for this job specifically; the workshop owns it briefly and
  // bills it on, but it never enters stock.
  EXTERNAL_PURCHASE
  // Supplied by the customer. Zero cost, labour billed separately, and the
  // workshop does not warrant the part itself.
  CUSTOMER_SUPPLIED
}

enum StockMovementType {
  ISSUE
  RETURN_TO_STOCK
  DAMAGED
  TRANSFER_IN
  TRANSFER_OUT
  SUPPLIER_RECEIPT
  ADJUSTMENT
  // A technician has sent a part back but it has not yet been accepted or
  // rejected -- the part is neither sellable nor still issued. Reversed by
  // a RETURN_TO_STOCK or DAMAGED movement of the same quantity when the
  // inventory manager decides, never left standing on its own.
  RETURN_PENDING
}

enum TransferStatus {
  REQUESTED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum SupplierOrderStatus {
  REQUESTED
  ORDERED
  RECEIVED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  WALLET
  DEPOSIT
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum DiscountRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// Phase 19.C.
enum RefundReasonCategory {
  ROUTINE
  DISPUTE_REMEDIATION
}

// Phase 19.D.
enum StaffRestrictionStatus {
  NONE
  RESTRICTED_PENDING_INVESTIGATION
}

enum CustomerDecisionStatus {
  PENDING
  SENT
  VIEWED
  PARTIALLY_RESPONDED
  RESOLVED
  EXPIRED
  // A decision can be withdrawn -- most often because the work order it
  // belongs to was cancelled while the customer had not yet answered.
  // Without this the request would sit PENDING forever and hold the
  // customer_decisions_resolved gate shut on a job nobody is doing.
  CANCELLED
}

enum CustomerDecisionItemDecision {
  PENDING
  APPROVED
  REJECTED
}

enum PermissionSource {
  ROLE_DEFAULT
  OWNER_OVERRIDE
}

enum ControlSettingScope {
  PLATFORM
  TENANT
}

enum AuditActorType {
  SYSTEM
  PLATFORM
  TENANT_STAFF
  CUSTOMER
}

// Required on every AuditLog row -- the gap analysis found the old build
// only populated risk level ad hoc, inside a JSON blob, for 2 of many
// audited action types. Making it a required column forces every writer
// to set it.
enum AuditRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================================================================
// IDENTITY & TENANCY
// ============================================================================

model Plan {
  id                String         @id @default(cuid())
  code              String         @unique
  name              String
  maxBranches       Int
  maxUsers          Int
  maxWarehouses     Int
  allowedCategories CategoryCode[]
  allowedModules    String[]
  allowedFeatures   String[]
  allowedReports    String[]
  allowedExports    String[]       @default([])
  monthlyPrice      Decimal        @db.Decimal(12, 2)
  createdAt         DateTime       @default(now())

  tenants Tenant[]

  @@map("plans")
}

model Tenant {
  id                       String       @id @default(cuid())
  name                     String
  // Lowercased mirror of `name`, maintained by application code on write.
  // Prisma's schema DSL has no expression/functional index (Postgres
  // supports `UNIQUE (lower(name))` directly, but not through @@unique),
  // so a real, unique shadow column is the portable way to enforce
  // Add Workshop Owner's "unique across the platform, case-insensitive"
  // rule without hand-writing provider-specific SQL into the migration.
  nameNormalized           String       @unique
  slug                     String       @unique
  customerRegistrationCode String       @unique
  status                   TenantStatus @default(PENDING_SETUP)
  planId                   String
  country                  String
  city                     String
  businessType             String
  primaryCategory          CategoryCode
  currency                 String // ISO 4217, e.g. "EGP", "USD", "AED" -- one currency per workshop
  timezone                 String // IANA identifier, e.g. "Africa/Cairo" -- all timestamps stored in UTC, converted for display using this
  // Phase 18.D -- two clocks, never conflated. `archivedAt` is when the
  // tenant stopped being a live subscription; `retentionUntil` is when
  // the platform's LEGAL obligation to keep the data ends, which can
  // outlive the subscription by years (Scenario 2's roll-cage records).
  // Both null for a tenant that has never been archived.
  archivedAt               DateTime?
  retentionUntil           DateTime?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  branches                Branch[]
  warehouses              Warehouse[]
  accounts                Account[]
  staffUsers              StaffUser[]
  teams                   Team[]
  customers               Customer[]
  assets                  Asset[]
  workOrders              WorkOrder[]
  inventoryItems          InventoryItem[]
  partRequests            PartRequest[]
  invoices                Invoice[]
  payments                Payment[]
  quotations              Quotation[]
  runningInvoices         RunningInvoice[]
  decisionRequests        CustomerDecisionRequest[]
  financeConfiguration    FinanceConfiguration?
  configuration           TenantConfiguration?
  capabilities            TenantCapability[]
  policies                WorkshopPolicy[]
  messageTemplates        MessageTemplate[]
  customFieldDefinitions  CustomFieldDefinition[]
  catalogCategories       CatalogCategory[]
  catalogAttributes       CatalogAttribute[]
  configurationVersions   TenantConfigurationVersion[]
  controlSettings         ControlSetting[]
  rolePermissions         RolePermission[]
  userPermissionOverrides UserPermissionOverride[]
  rolePages               RolePage[]
  auditLogs               AuditLog[]
  operationEvents         OperationEvent[]
  analystSavedViews       AnalystSavedView[]
  stakeholders            TenantStakeholder[]
  groupMemberships        TenantGroupMember[]
  liveViewSessions        PlatformLiveViewSession[]
  workflowIssueAcks       WorkflowIssueAcknowledgement[]
  workshopSpecializations WorkshopSpecialization[]

  @@index([status])
  @@map("tenants")
}

// Platform + tenant-level overrides that sit above everything else in the
// effective permission resolver. One row per (scope, tenantId?, key).
model ControlSetting {
  id        String              @id @default(cuid())
  scope     ControlSettingScope
  tenantId  String?
  key       String
  value     Json
  type      String
  active    Boolean             @default(true)
  reason    String?
  createdBy String
  createdAt DateTime            @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, key])
  @@index([scope, key])
  @@map("control_settings")
}

model Branch {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  code     String
  address  String?
  city     String?
  isActive Boolean @default(true)

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseAccess BranchWarehouseAccess[]
  workOrders      WorkOrder[]
  teams           Team[]
  invoices        Invoice[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model Warehouse {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  code     String
  isActive Boolean @default(true)

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchAccess   BranchWarehouseAccess[]
  stockBalances  WarehouseStockBalance[]
  issuedItems    IssuedItem[]
  stockMovements StockMovement[]
  transfersOut   InventoryTransfer[]     @relation("TransferSource")
  transfersIn    InventoryTransfer[]     @relation("TransferDestination")
  supplierOrders SupplierOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

model BranchWarehouseAccess {
  id          String @id @default(cuid())
  tenantId    String
  branchId    String
  warehouseId String

  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([branchId, warehouseId])
  @@index([tenantId])
  @@map("branch_warehouse_access")
}

// One row per login credential. accountType decides which profile table
// (StaffUser / Customer) it is linked from. Platform and system-automation
// accounts have no StaffUser/Customer profile at all.
model Account {
  id               String        @id @default(cuid())
  accountType      AccountType
  tenantId         String?
  email            String?
  phone            String?
  passwordHash     String?
  status           AccountStatus @default(ACTIVE)
  failedLoginCount Int           @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime      @default(now())

  // Set when an account is created without a password (status = INVITED --
  // e.g. a new workshop owner) and cleared the moment the invite is
  // redeemed. The raw token is never stored, only this hash, matching the
  // same pattern session secrets already use (see auth/token.util.ts).
  inviteTokenHash             String?
  inviteTokenExpiresAt        DateTime?
  // Password reset is distinct from invite activation: an invited account
  // is not active yet, while a reset is recovery for an existing account.
  // The raw reset token is never stored, only this hash.
  passwordResetTokenHash      String?
  passwordResetTokenExpiresAt DateTime?

  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff             StaffUser?
  customer          Customer?
  sessions          Session[]
  analystSavedViews AnalystSavedView[]

  // A stakeholder relationship to OTHER tenants, distinct from `tenant`
  // above (the one tenant this account's own StaffUser/Customer row
  // belongs to, if any). Phase 18.A: a person can be a real employee of
  // one tenant and a narrow, view-only stakeholder of several others.
  stakeholderOf TenantStakeholder[]

  @@unique([tenantId, email])
  @@index([accountType, tenantId])
  @@index([passwordResetTokenHash])
  @@map("accounts")
}

model AnalystSavedView {
  id            String                     @id @default(cuid())
  tenantId      String
  accountId     String
  name          String
  sourcePage    AnalystSavedViewSourcePage
  configuration Json
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId, accountId, createdAt])
  @@index([tenantId, sourcePage])
  @@map("analyst_saved_views")
}

model Session {
  id               String    @id @default(cuid())
  accountId        String
  tenantId         String?
  accessSecretHash String
  refreshTokenHash String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("sessions")
}

model StaffUser {
  id                String                 @id @default(cuid())
  accountId         String                 @unique
  tenantId          String
  fullName          String
  role              StaffRole
  branchScope       String[]
  warehouseScope    String[]
  categoryScope     CategoryCode[]
  isActive          Boolean                @default(true)
  lockedAt          DateTime?
  // Phase 19.D -- a third state between "active" and the platform-wide
  // tenant freeze, which Workshop 5 scenario 24 found is the only lever
  // that previously existed and is far too large a hammer for a single
  // account under investigation. Curtailed, pending resolution -- not a
  // declaration of guilt.
  restrictionStatus StaffRestrictionStatus @default(NONE)
  restrictedAt      DateTime?
  restrictedReason  String?
  createdAt         DateTime               @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ledTeams            Team[]                   @relation("TeamLeader")
  teamMemberships     TeamMembership[]
  assignedWorkOrders  WorkOrderAssignment[]
  taskAssignments     TaskAssignment[]
  permissionOverrides UserPermissionOverride[]
  credentials         StaffCredential[]

  @@index([tenantId, role])
  @@map("staff_users")
}

// New model -- the old build had no Team/TeamMembership table at all, so
// "Team Setup" and Team Leader scoping had nothing real to attach to.
model Team {
  id           String   @id @default(cuid())
  tenantId     String
  branchId     String?
  name         String
  teamLeaderId String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  teamLeader StaffUser        @relation("TeamLeader", fields: [teamLeaderId], references: [id], onDelete: Restrict)
  members    TeamMembership[]

  @@index([tenantId])
  @@map("teams")
}

// Membership is time-ranged (endedAt null = currently active) so history
// is preserved when a technician moves teams, per spec.
model TeamMembership {
  id           String    @id @default(cuid())
  tenantId     String
  teamId       String
  technicianId String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  technician StaffUser @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([teamId, endedAt])
  @@index([technicianId, endedAt])
  @@map("team_memberships")
}

// The one place in the product where a note is deliberately hidden from
// the person it's about (docs/detailed-specs/team-leader.md). Never
// exposed on any technician-facing endpoint -- enforced by absence from
// that API shape entirely, never hidden client-side.
model SupervisionNote {
  id           String   @id @default(cuid())
  tenantId     String
  technicianId String
  authorId     String
  body         String
  // A lightweight escalation, not a state change: flags the note for a
  // Branch Manager's attention without touching any WorkOrder or Task.
  escalated    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([tenantId, technicianId])
  @@map("supervision_notes")
}

// POST_CLOSE_ADDENDA (packages/shared/src/policies/registry.ts). Nothing
// on a closed WorkOrder is ever edited -- this is the real, additive
// append operation the policy governs: whether one may be added at all
// once the job is CLOSED. Immutable once written, like every other
// historical record in this schema; there is no update or delete path.
model WorkOrderNote {
  id          String   @id @default(cuid())
  tenantId    String
  workOrderId String
  authorId    String
  authorName  String
  body        String
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, workOrderId])
  @@map("work_order_notes")
}

// ============================================================================
// SPECIALIZATION PRIMITIVES (Phase 15)
//
// Five kinds of workshop-defined vocabulary, per docs/phases/PHASE_15.md.
// The discipline carried over from the capability engine: the *engine* is
// code (this schema, and the services that read/write it), the *shape* is
// data a workshop authors -- never a new Prisma model per service type.
// ============================================================================

enum SpecializationKind {
  SERVICE_CARD
  MEASUREMENT_FORM
}

enum SpecializationFieldType {
  TEXT
  DECIMAL
  ENUM
  BOOLEAN
}

// A workshop-authored "shape to fill in" -- Nafath's oil-change service
// card (viscosity: enum, litres: decimal) and Delta's hydraulic diagnostic
// form (six test points, each with a unit) are both rows here, not
// separate tables, because the two are the same underlying primitive
// (a named set of typed fields) wearing two labels. `kind` exists only so
// a page can ask "show me this category's service cards" separately from
// "show me its diagnostic forms" -- it changes nothing about how a
// definition is stored or validated.
model SpecializationDefinition {
  id        String             @id @default(cuid())
  tenantId  String
  category  CategoryCode
  kind      SpecializationKind
  name      String
  // Bumped whenever `fields` changes. An entry pins the version it was
  // filled against (see SpecializationEntry.definitionVersion) rather than
  // silently reinterpreting old data against a newer shape -- the same
  // pattern capability profiles use for historical interpretation, per
  // this phase's own "open question" about editing a card after 200 have
  // already been filled in.
  version   Int                @default(1)
  isActive  Boolean            @default(true)
  // Array of { key, label, type: SpecializationFieldType, unit?, enumOptions?, required }.
  // Deliberately Json, not a child table: a field list is authored and
  // read as one unit, never queried field-by-field across definitions.
  fields    Json
  createdAt DateTime           @default(now())

  entries SpecializationEntry[]

  @@index([tenantId, category, kind])
  @@map("specialization_definitions")
}

model SpecializationEntry {
  id                String   @id @default(cuid())
  tenantId          String
  definitionId      String
  // Pinned at fill time, never re-read from the live definition -- if the
  // card's fields change after this entry exists, this entry keeps
  // meaning what it meant when a technician filled it in.
  definitionVersion Int
  workOrderId       String?
  taskId            String?
  // { [fieldKey]: value }, validated against the pinned definition's
  // fields at write time (see SpecializationService), not re-validated on
  // every read -- the same trust boundary as everywhere else in this
  // schema: validate at the write, trust the stored shape after.
  values            Json
  filledById        String
  filledAt          DateTime @default(now())

  definition SpecializationDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@index([tenantId, definitionId])
  @@index([workOrderId])
  @@map("specialization_entries")
}

// Persisted assignment of a specialization pack/domain to a workshop.
// This is what lets runtime services (RelevanceContext, ResolvedWorkshopModel,
// TechnicianWorkView) query "which specializations does this workshop have"
// deterministically without re-parsing snapshots or guessing from definitions.
model WorkshopSpecialization {
  id                String   @id @default(cuid())
  tenantId          String
  specializationKey String
  source            String   @default("BUILT_IN") // BUILT_IN | CUSTOM
  assignedAt        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, specializationKey])
  @@index([tenantId])
  @@map("workshop_specializations")
}

// Per-category "where on the asset" vocabulary (FL/FR/RL/RR for cars,
// cylinder number for generators). `tenantId: null` is the platform
// default for that category; a workshop row with the same category
// overrides it for that tenant only. Category defaults rather than fully
// free-form per-workshop, per this phase's own open-question answer:
// otherwise two workshops' position data becomes incomparable for no
// reason.
model PositionTaxonomyEntry {
  id        String       @id @default(cuid())
  tenantId  String?
  category  CategoryCode
  code      String
  label     String
  sortOrder Int          @default(0)

  @@unique([tenantId, category, code])
  @@index([category])
  @@map("position_taxonomy_entries")
}

// A workshop-defined attribute a technician can hold, with an optional
// expiry -- checked against a job requirement (the check itself is
// follow-on work once 15-17 land; this phase settles only the schema and
// proves grant/read).
model CredentialDefinition {
  id        String        @id @default(cuid())
  tenantId  String
  category  CategoryCode?
  name      String
  createdAt DateTime      @default(now())

  staffCredentials StaffCredential[]

  @@index([tenantId])
  @@map("credential_definitions")
}

model StaffCredential {
  id                     String    @id @default(cuid())
  tenantId               String
  staffUserId            String
  credentialDefinitionId String
  earnedAt               DateTime  @default(now())
  expiresAt              DateTime?

  staffUser  StaffUser            @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  definition CredentialDefinition @relation(fields: [credentialDefinitionId], references: [id], onDelete: Restrict)

  @@index([staffUserId])
  @@index([credentialDefinitionId])
  @@map("staff_credentials")
}

enum BlockerBehavior {
  PAUSE_CLOCK
  ESCALATE
  NOTIFY
  NONE
}

// A workshop-defined blocker reason, mapped to one of a fixed, product-
// owned set of behaviours -- the reason's *label* is the workshop's own
// vocabulary, but what it *does* is never workshop-defined, per this
// phase's source finding (A 3.2). Schema only this phase: TaskBlocker
// itself keeps using the existing fixed BlockerReason enum until a later
// pass retrofits it, named rather than silently done in docs/phases/PHASE_15.md.
model BlockerReasonDefinition {
  id       String          @id @default(cuid())
  tenantId String
  code     String
  label    String
  behavior BlockerBehavior
  isActive Boolean         @default(true)

  @@unique([tenantId, code])
  @@map("blocker_reason_definitions")
}

// Phase 16.H -- a generic attachment, built once and reused everywhere a
// work item, inspection, or addendum needs a photo or file, rather than
// bolted onto each surface separately (the flat gap named in
// docs/phases/PHASE_16.md, no workshop-specific angle). `targetType` +
// `targetId` is a polymorphic reference by convention, the same shape
// AuditLog already uses for the same reason: one table serving many kinds
// of target without a foreign key per target type.
model Attachment {
  id           String   @id @default(cuid())
  tenantId     String
  targetType   String
  targetId     String
  fileName     String
  contentType  String
  storageKey   String
  uploadedById String
  uploadedAt   DateTime @default(now())

  @@index([tenantId, targetType, targetId])
  @@map("attachments")
}

// ============================================================================
// TENANT RELATIONSHIPS (Phase 18)
//
// `Tenant.id` is treated everywhere else in this schema as permanent,
// isolated, and singular -- correctly so; CLAUDE.md names that isolation
// as load-bearing. These three models are the exception the phase found:
// real businesses have relationships TO a tenant (a stakeholder, Phase
// 18.A) and ACROSS tenants (a portfolio group, Phase 18.E) that are not
// themselves tenant-scoped operational data.
// ============================================================================

// A person with a legitimate, ongoing need to see part of a tenant
// without being its employee -- an investor, a franchisor, a parent
// company. Deliberately independent of StaffUser: a stakeholder's
// permission set is narrow and explicit (financial-only, branch-scoped,
// never an operational StaffRole), not a role borrowed from the staff
// enum and then trusted to stay narrow by convention.
model TenantStakeholder {
  id          String    @id @default(cuid())
  tenantId    String
  accountId   String
  label       String
  // Explicit, narrow keys -- e.g. "finance.summary.view_only",
  // "branch.status.view_only" -- never a StaffRole. A stakeholder that
  // needs more than a handful of narrow view permissions is a sign they
  // should be a real StaffUser with a real role, not a sign this list
  // should grow to look like one.
  permissions String[]
  branchScope String[]
  grantedById String
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId, revokedAt])
  @@index([accountId])
  @@map("tenant_stakeholders")
}

// A named, read-only aggregate view across several tenants -- a holding
// company's portfolio, a franchise's owned-vs-licensed split. Explicitly
// summary-only (Phase 18.E): this model and its members exist to answer
// "how is my portfolio doing," never to drill into one tenant's
// row-level detail, which stays a Phase 19 separation-of-duties question.
model TenantGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdById String
  createdAt   DateTime @default(now())

  members TenantGroupMember[]

  @@map("tenant_groups")
}

model TenantGroupMember {
  id            String   @id @default(cuid())
  tenantGroupId String
  tenantId      String
  addedAt       DateTime @default(now())

  tenantGroup TenantGroup @relation(fields: [tenantGroupId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantGroupId, tenantId])
  @@index([tenantId])
  @@map("tenant_group_members")
}

// Phase 19.B -- a closed work order's factual accuracy formally in
// question needs a visible flag that travels everywhere the record is
// shown, without altering WorkOrderStatus (WorkOrderLifecycleService's
// exclusive domain, unchanged) and without deleting or editing history.
// Non-destructive by construction: this table only ever adds a row: no
// column here can rewrite anything WorkOrder or Task already recorded.
model WorkOrderDispute {
  id             String    @id @default(cuid())
  tenantId       String
  workOrderId    String
  raisedById     String
  reason         String
  status         String    @default("OPEN")
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, workOrderId])
  @@index([tenantId, status])
  @@map("work_order_disputes")
}

model Customer {
  id           String               @id @default(cuid())
  tenantId     String
  accountId    String?              @unique
  fullName     String
  phone        String
  email        String?
  portalStatus CustomerPortalStatus @default(NOT_INVITED)
  createdAt    DateTime             @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  ownedAssets      AssetOwnershipHistory[]
  workOrders       WorkOrder[]
  decisionRequests CustomerDecisionRequest[]
  timelineEvents   CustomerTimelineEvent[]

  @@index([tenantId, phone])
  @@map("customers")
}

// ============================================================================
// PERMISSIONS
// ============================================================================

// The tenant's own effective permission set per role, seeded from a static
// default map at tenant creation and editable by the Owner. Whether a cell
// is *locked* by platform or plan is computed at resolve time from
// ControlSetting + Plan.allowedFeatures, not stored redundantly here.
model RolePermission {
  id            String           @id @default(cuid())
  tenantId      String
  role          StaffRole
  permissionKey String
  allowed       Boolean
  source        PermissionSource @default(ROLE_DEFAULT)
  updatedBy     String?
  updatedAt     DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role, permissionKey])
  @@index([tenantId, role])
  @@map("role_permissions")
}

model UserPermissionOverride {
  id            String   @id @default(cuid())
  tenantId      String
  staffUserId   String
  permissionKey String
  allowed       Boolean
  reason        String?
  createdBy     String
  createdAt     DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@unique([staffUserId, permissionKey])
  @@index([tenantId])
  @@map("user_permission_overrides")
}

model RolePage {
  id       String    @id @default(cuid())
  tenantId String
  role     StaffRole
  pageId   String
  allowed  Boolean   @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role, pageId])
  @@map("role_pages")
}

// ============================================================================
// OPERATIONS -- ASSETS, WORK ORDERS, TASKS, INSPECTIONS
// ============================================================================

model Asset {
  id                     String       @id @default(cuid())
  tenantId               String
  category               CategoryCode
  plateNumber            String?
  vinOrChassisNumber     String?
  engineNumber           String?
  serialNumber           String?
  hourMeter              Decimal?     @db.Decimal(12, 2)
  site                   String?
  fleet                  String?
  operator               String?
  currentOwnerCustomerId String?
  createdAt              DateTime     @default(now())

  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownershipHistory AssetOwnershipHistory[]
  workOrders       WorkOrder[]
  safeHistory      SafeTechnicalHistory[]

  @@index([tenantId, plateNumber])
  @@index([tenantId, serialNumber])
  @@map("assets")
}

// One open row (endedAt null) = current owner. Closed rows are how a new
// owner's technical-history view excludes a previous owner's private data.
model AssetOwnershipHistory {
  id         String    @id @default(cuid())
  tenantId   String
  assetId    String
  customerId String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([assetId, endedAt])
  @@index([customerId])
  @@map("asset_ownership_history")
}

model WorkOrder {
  id                      String          @id @default(cuid())
  tenantId                String
  branchId                String
  assetId                 String
  customerId              String
  status                  WorkOrderStatus @default(DRAFT)
  priority                String          @default("normal")
  // The customer declined inspection and asked for one named service
  // (SCENARIOS.md 1.2). Recorded as a fact rather than inferred from the
  // absence of an Inspection row, because "not inspected yet" and "will
  // not be inspected" are different states -- and the Finish Gate must
  // not block a job for a step the customer refused.
  inspectionDeclined      Boolean         @default(false)
  relinkedFromWorkOrderId String?
  // Phase 16.A -- the promised time a queue can order by. Nafath's
  // walk-in queue and SpeedLube's SLA clock are the same underlying
  // concept at different granularities; this one field serves both.
  promisedAt              DateTime?
  // Phase 16.E -- workshop-defined, in minutes. Null means no SLA is
  // tracked for this job, not "zero minutes allowed". The Attention
  // Center's over-run signal (AttentionQueueService.slaOverruns) reads
  // this alongside `updatedAt` as the best available proxy for "since
  // work started", the same honest-not-precise pattern already used for
  // the WAITING_PARTS/QC_FAILED attention items until the lifecycle
  // records a real state-entry timestamp.
  expectedDurationMinutes Int?
  qcFailureReason         QcFailureReason?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  closedAt                DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  relinkedFrom WorkOrder?  @relation("WorkOrderRelink", fields: [relinkedFromWorkOrderId], references: [id], onDelete: SetNull)
  relinkedTo   WorkOrder[] @relation("WorkOrderRelink")

  assignments        WorkOrderAssignment[]
  tasks              Task[]
  inspections        Inspection[]
  faults             Fault[]
  partRequests       PartRequest[]
  partLines          WorkOrderPartLine[]
  quotation          Quotation?
  runningInvoice     RunningInvoice?
  invoice            Invoice?
  decisionRequests   CustomerDecisionRequest[]
  timelineEvents     CustomerTimelineEvent[]
  safeHistoryEntries SafeTechnicalHistory[]
  disputes           WorkOrderDispute[]
  notes              WorkOrderNote[]

  @@index([tenantId, status])
  @@index([tenantId, branchId, status])
  @@index([tenantId, customerId])
  @@index([assetId])
  @@index([tenantId, createdAt])
  @@index([tenantId, closedAt])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, branchId, closedAt])
  @@map("work_orders")
}

model WorkOrderAssignment {
  id           String    @id @default(cuid())
  tenantId     String
  workOrderId  String
  staffUserId  String
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([staffUserId, unassignedAt])
  @@map("work_order_assignments")
}

model Task {
  id             String     @id @default(cuid())
  tenantId       String
  workOrderId    String
  title          String
  // Which catalogued service this task performs, when it performs one.
  //
  // Stored as PriceCatalogEntry.itemKey rather than as a foreign key to a
  // specific row on purpose: that table is effective-dated, so a row id
  // identifies one *version* of a price. "This task is a battery
  // replacement" is a fact about the work and must not change meaning
  // when the Owner reprices it, while "what we charged" is already
  // captured on the invoice line at the moment of billing. Keying by the
  // stable business key keeps those two questions apart, and matches the
  // rule the catalogue's own comment sets out -- nothing that already read
  // a price is stored by reference to this table.
  //
  // Null for ad-hoc work. A workshop is allowed to do something that is
  // not in its catalogue, and free-text `title` remains the fallback.
  serviceKey     String?
  // Which approved customer recommendation this task carries out, when it
  // carries one out.
  //
  // The link exists because "was this recommendation performed?" has no
  // other honest answer. A CustomerDecisionItem records what the customer
  // agreed to; a Task records what the workshop actually did; without a
  // stored relationship between them the only way to connect the two is
  // to compare free text, and a history that says "COMPLETED" on the
  // strength of a string match is exactly the silent lie the whole
  // product exists to avoid. Null for ordinary work that was never a
  // recommendation, which is most tasks.
  //
  // Not unique: one approved item can legitimately need several tasks
  // ("Replace front brake discs" as a strip, a fit and a road test), and
  // partial completion across them is a real state history must be able
  // to report.
  decisionItemId String?
  status         TaskStatus        @default(ASSIGNED)
  originalTaskId String?
  reworkReason   TaskReworkReason?
  reworkNote     String?
  // TIME_TRACKING (packages/shared/src/policies/registry.ts). Minutes the
  // technician reports at completion, whole minutes because that is the
  // granularity the Work Card's control actually offers -- not derived
  // from startedAt/updatedAt, since a task blocked and resumed later
  // would make elapsed wall-clock time overstate time actually worked.
  // Null under OFF (the field is never written) and under OPTIONAL when
  // the technician chose not to record it; REQUIRED refuses completion
  // without it.
  actualMinutes  Int?
  // When a technician actually picked this task up.
  //
  // The left-hand side of "did this repair start before the inspection
  // was finished, or before the customer agreed to it?" -- a question the
  // ordering check in GateEvaluatorService has to answer and, until this
  // field existed, could not. `updatedAt` is not a substitute: it moves
  // again on completion, on a blocker, on rework, so a job that started
  // legally and was touched later would read as having started later.
  //
  // Null for tasks created before this was recorded, and for tasks nobody
  // has started yet. Those two are distinguishable by `status`.
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  workOrder    WorkOrder             @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  // SetNull rather than Cascade: a cancelled decision request must not
  // delete the record of work the workshop actually performed.
  decisionItem CustomerDecisionItem? @relation(fields: [decisionItemId], references: [id], onDelete: SetNull)
  originalTask Task?                 @relation("TaskRework", fields: [originalTaskId], references: [id], onDelete: SetNull)
  reworkTasks  Task[]                @relation("TaskRework")
  subtasks     Subtask[]
  assignments  TaskAssignment[]
  blockers     TaskBlocker[]

  @@index([tenantId, status])
  @@index([tenantId, status, completedAt])
  @@index([workOrderId])
  // Answers "what was done about this recommendation" without a scan.
  @@index([decisionItemId])
  // Answers "which tasks were rework for an original task" without a scan.
  @@index([originalTaskId])
  // Answers "how much battery-replacement work did we do" without a scan.
  @@index([tenantId, serviceKey])
  @@map("tasks")
}

model Subtask {
  id        String   @id @default(cuid())
  tenantId  String
  taskId    String
  title     String
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("subtasks")
}

model TaskAssignment {
  id           String    @id @default(cuid())
  tenantId     String
  taskId       String
  staffUserId  String
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([staffUserId, unassignedAt])
  @@map("task_assignments")
}

model TaskBlocker {
  id         String        @id @default(cuid())
  tenantId   String
  taskId     String
  reason     BlockerReason
  note       String?
  status     BlockerStatus @default(OPEN)
  reportedBy String
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, status])
  @@map("task_blockers")
}

model Inspection {
  id              String         @id @default(cuid())
  tenantId        String
  workOrderId     String
  technicianId    String
  type            InspectionType
  odometerOrHours Decimal?       @db.Decimal(12, 2)
  fields          Json
  note            String?
  // The inspection as a piece of WORK, not only as a set of findings.
  //
  // MOP's authorization boundary is "a Task exists only for work the
  // effective workflow already authorized", which makes Inspection the
  // one vehicle for diagnostic work performed BEFORE that authorization
  // exists. That only holds up if an inspection can say when it started
  // and when it finished: without `completedAt` there is no way to refuse
  // an inspection written after the repair it was supposed to justify,
  // and "the customer's car was diagnosed for 40 minutes" is a fact the
  // workshop cannot bill, staff, or measure.
  //
  // `startedAt` defaults rather than being nullable because an inspection
  // row is only ever created by a technician who is doing one. Null
  // `completedAt` is the honest representation of an inspection still in
  // progress, and is what the ordering check treats as "not yet done".
  startedAt       DateTime       @default(now())
  completedAt     DateTime?
  // Minutes the technician reports, on the same TIME_TRACKING policy and
  // for the same reason as Task.actualMinutes -- diagnostic labour is
  // labour, and a workshop that tracks time on repairs but cannot see
  // what diagnosis costs is measuring half its floor.
  actualMinutes   Int?
  createdAt       DateTime       @default(now())

  workOrder    WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  faults       Fault[]
  // Parts consumed by the diagnosis itself. See PartRequest.inspectionId.
  partRequests PartRequest[]

  @@index([workOrderId])
  @@map("inspections")
}

model Fault {
  id                       String        @id @default(cuid())
  tenantId                 String
  workOrderId              String
  inspectionId             String?
  code                     String?
  description              String
  severity                 SeverityLevel
  recommendedService       String?
  customerApprovalRequired Boolean       @default(true)
  createdAt                DateTime      @default(now())

  workOrder     WorkOrder              @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inspection    Inspection?            @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  // What was recommended to the customer about this finding.
  decisionItems CustomerDecisionItem[]

  @@index([workOrderId])
  @@map("faults")
}

// ============================================================================
// INVENTORY
// ============================================================================

model InventoryItem {
  id                     String         @id @default(cuid())
  tenantId               String
  sku                    String
  name                   String
  itemType               String
  // The ONE taxonomy. Replaced the free-text `category`/`subcategory`
  // pair in 20260902090000_catalog_taxonomy_and_attributes: two shapes of
  // "which kind of thing is this" meant the inventory manager typed one
  // and the technician browsed the other, with nothing keeping them
  // agreeing. Nullable because an item may be catalogued before anyone
  // has decided where it belongs.
  catalogCategoryId      String?
  compatibleCategories   CategoryCode[]
  lowStockThreshold      Int            @default(0)
  criticalStockThreshold Int            @default(0)
  sellingPrice           Decimal        @db.Decimal(12, 2)
  cost                   Decimal?       @db.Decimal(12, 2)
  workOrderUsable        Boolean        @default(true)
  posVisible             Boolean        @default(true)
  stockTracked           Boolean        @default(true)
  barcode                String?
  supplier               String?
  notes                  String?
  // Catalog presentation. A technician picks a part by sight before they
  // read its name, so the picture is catalog data, not decoration.
  imageUrl               String?
  // The one line under the name on a card: "Ceramic, low dust". Distinct
  // from `notes`, which is the storekeeper's own memo and is never shown
  // to a technician.
  summary                String?
  createdAt              DateTime       @default(now())

  tenant          Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  catalogCategory CatalogCategory?              @relation(fields: [catalogCategoryId], references: [id], onDelete: SetNull)
  attributeValues InventoryItemAttributeValue[]
  stockBalances   WarehouseStockBalance[]
  partRequests    PartRequest[]
  partLines       WorkOrderPartLine[]
  movements       StockMovement[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, catalogCategoryId])
  @@map("inventory_items")
}

// ---------------------------------------------------------------------
// CATALOG CONFIGURATION
//
// Configuration, not stock and not transactions. The inventory manager
// builds this; the technician only ever reads it. A category exists
// whether or not anything is on the shelf, which is why nothing here
// carries a quantity.
// ---------------------------------------------------------------------

model CatalogCategory {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  // Stable across renames, because a renamed category must not orphan
  // the items pointing at it or break a bookmarked filter.
  slug              String
  // One level of nesting: "Brakes > Pads". Deeper trees were rejected --
  // a technician navigating a phone at a car cannot drill four levels.
  parentId          String?
  description       String?
  sortOrder         Int      @default(0)
  // Deactivated, never deleted: items keep pointing at it and past
  // requests keep naming it. Hidden from the technician, still visible
  // to the manager who has to move the items out.
  isActive          Boolean  @default(true)
  // A category the workshop uses internally but does not want in a
  // technician's browse -- e.g. consumables bought in bulk and never
  // requested per job.
  technicianVisible Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant     Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent     CatalogCategory?           @relation("CatalogCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   CatalogCategory[]          @relation("CatalogCategoryTree")
  attributes CatalogCategoryAttribute[]
  items      InventoryItem[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@index([parentId])
  @@map("catalog_categories")
}

// A filter dimension the inventory manager invents: "Vehicle Type",
// "Brand", "Engine Size".
//
// Deliberately NOT reusing CustomFieldDefinition. That table is additive
// form capture: its values are copied into each record's own `fields`
// JSON at fill time and are never queried back. A catalog filter is the
// opposite -- it has to be indexable and joinable, because filtering the
// catalog is the hot path a technician waits on.
model CatalogAttribute {
  id         String   @id @default(cuid())
  tenantId   String
  key        String
  label      String
  // Shown under the name on a product card, e.g. Brand and Engine Size
  // on a brake pad. Filtering works either way; this decides what the
  // card says.
  showOnCard Boolean  @default(true)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values     CatalogAttributeValue[]
  categories CatalogCategoryAttribute[]
  assigned   InventoryItemAttributeValue[]

  @@unique([tenantId, key])
  @@index([tenantId, isActive])
  @@map("catalog_attributes")
}

model CatalogAttributeValue {
  id          String   @id @default(cuid())
  tenantId    String
  attributeId String
  value       String
  label       String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  attribute CatalogAttribute              @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  assigned  InventoryItemAttributeValue[]

  @@unique([attributeId, value])
  @@index([tenantId])
  @@map("catalog_attribute_values")
}

// Which filters a category offers. Without this, every technician sees
// every filter in the workshop -- including "Engine Size" while browsing
// windscreen wipers.
model CatalogCategoryAttribute {
  id          String @id @default(cuid())
  tenantId    String
  categoryId  String
  attributeId String
  sortOrder   Int    @default(0)

  category  CatalogCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute CatalogAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeId])
  @@index([tenantId])
  @@map("catalog_category_attributes")
}

// What a part actually IS, in the vocabulary above. One row per value,
// so a part that fits both Toyota and Hyundai is two rows rather than a
// JSON blob no index can reach.
model InventoryItemAttributeValue {
  id              String @id @default(cuid())
  tenantId        String
  inventoryItemId String
  attributeId     String
  valueId         String

  inventoryItem InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  attribute     CatalogAttribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value         CatalogAttributeValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@unique([inventoryItemId, valueId])
  @@index([tenantId, attributeId, valueId])
  @@index([valueId])
  @@map("inventory_item_attribute_values")
}

// Never-negative is enforced in BOTH places, and deliberately so:
// StockService refuses the movement and produces the message a human can
// act on, while DB-level CHECK constraints make it impossible for a seed
// script, a data fix, or a future service to write a negative quantity of
// a physical object. Service code is a promise; a constraint is a fact.
// Added in 20260809203000_stock_never_negative.
model WarehouseStockBalance {
  id               String @id @default(cuid())
  tenantId         String
  inventoryItemId  String
  warehouseId      String
  availableQty     Int    @default(0)
  reservedQty      Int    @default(0)
  issuedQty        Int    @default(0)
  returnPendingQty Int    @default(0)
  damagedQty       Int    @default(0)

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([inventoryItemId, warehouseId])
  @@index([tenantId])
  @@map("warehouse_stock_balances")
}

model PartRequest {
  id              String            @id @default(cuid())
  tenantId        String
  workOrderId     String
  taskId          String?
  // The diagnosis this part was consumed by, when no authorized task
  // exists yet.
  //
  // Under the inspection-first boundary a PartRequest must belong to
  // authorized work -- but a diagnosis legitimately consumes things (a
  // test cartridge, a diagnostic seal) before any repair has been agreed.
  // Without this column that case had two bad answers: refuse it, or open
  // a hole big enough to fit every unauthorized part through. Naming the
  // inspection keeps the request attached to real, permitted work.
  //
  // Mutually exclusive with `taskId` in practice, not by constraint: a
  // request is raised for one or the other, and both null is a job-level
  // request on an already-authorized order.
  inspectionId    String?
  inventoryItemId String
  requestedById   String
  // Phase 19.A -- who approved it, so `issue()` can refuse the same
  // account both approving and issuing the same request (separation of
  // duties: INVENTORY_MANAGER's default role grants both permissions,
  // which let one account close the loop with no second person ever
  // required to look at it).
  approvedById    String?
  // Paired with `approvedById` for the same reason it exists: the
  // journey has to be able to date "the store approved this", and
  // `updatedAt` is the time of the LAST write, which for a request that
  // was later issued and used is a different moment entirely.
  approvedAt      DateTime?
  quantity        Int
  urgency         String            @default("normal")
  reason          String?
  status          PartRequestStatus @default(DRAFT)
  // The cart this request came out of, when it came from one.
  //
  // A technician on a workshop phone taps Submit, the connection stalls,
  // and they tap again -- without this, the store gets two of everything
  // and has to work out which basket was real. The client mints the key
  // once when the cart is opened, so both taps carry the same one and
  // the second is answered with the requests the first created.
  //
  // Null for every request raised any other way, and Postgres treats
  // NULLs as distinct, so the unique index below constrains carts only.
  cartKey         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrder     WorkOrder          @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  // SetNull, not Cascade: deleting an inspection must never delete the
  // record of stock that actually left the shelf.
  inspection    Inspection?        @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  // Many: one request can be filled in more than one hand-over.
  issuedItems   IssuedItem[]
  returnRequest PartReturnRequest?
  partLine      WorkOrderPartLine?

  @@unique([tenantId, cartKey, inventoryItemId])
  @@index([tenantId, status])
  @@index([workOrderId])
  @@map("part_requests")
}

// Every part that goes onto a work order, whatever its origin -- this is
// the billing-facing record, distinct from PartRequest, which is the
// inventory-facing one.
//
// The split matters because not every part has a PartRequest: a
// customer-supplied part never touches the warehouse, so it has no
// request, no issue, no stock movement and no cost. Forcing those through
// PartRequest would mean either a nullable inventoryItemId on a table
// whose whole purpose is to reference stock, or fake inventory rows for
// parts the workshop never owned.
model WorkOrderPartLine {
  id                String         @id @default(cuid())
  tenantId          String
  workOrderId       String
  taskId            String?
  provenance        PartProvenance
  // Set only when provenance is INVENTORY. Null for anything the workshop
  // did not supply from its own stock.
  inventoryItemId   String?
  // Free text for non-inventory parts, where there is no catalogue row to
  // name them.
  name              String
  quantity          Int            @default(1)
  // What the customer is charged for the part itself. Zero for
  // CUSTOMER_SUPPLIED -- the labour is charged separately, on its own line.
  sellingPrice      Decimal        @default(0) @db.Decimal(12, 2)
  // Null unless the workshop actually paid for it. Never set for
  // CUSTOMER_SUPPLIED, and never exposed to the customer.
  cost              Decimal?       @db.Decimal(12, 2)
  // Recorded explicitly rather than inferred from provenance, because it
  // is the fact a warranty dispute turns on and must survive any later
  // change to how provenance is interpreted.
  workshopWarranted Boolean        @default(true)
  // Links back to the inventory flow when there is one.
  partRequestId     String?        @unique
  addedById         String
  createdAt         DateTime       @default(now())

  workOrder     WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  partRequest   PartRequest?   @relation(fields: [partRequestId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@index([tenantId, provenance])
  @@map("work_order_part_lines")
}

model IssuedItem {
  id String @id @default(cuid())

  tenantId      String
  // Deliberately NOT unique -- see docs/phases/PHASE_7.md section 2 and
  // SCENARIOS.md 3.5. One request, many issues: "3 requested, 2 issued,
  // 1 issued tomorrow" is one thing the technician asked for and two
  // hand-overs that actually happened. Splitting it into two requests
  // would invent a record they never created and would split the charge
  // on the customer's invoice.
  //
  // Fulfilment is therefore DERIVED, never stored: requested lives on
  // PartRequest, issued is SUM(quantity) here. Nothing may cache that
  // sum in a column -- a cached total is a second source of truth, and
  // the two will eventually disagree.
  partRequestId String
  warehouseId   String
  // Requested quantity lives on PartRequest; this is what was actually
  // issued in THIS hand-over, which can be less than what was asked.
  quantity      Int
  issuedById    String
  issuedAt      DateTime  @default(now())
  arrivedAt     DateTime?
  receivedAt    DateTime?
  usedAt        DateTime?

  partRequest PartRequest @relation(fields: [partRequestId], references: [id], onDelete: Cascade)
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  // Replaces the unique constraint. Summing issues for one request is now
  // the hot path -- it is how fulfilment is computed -- so it needs an
  // index of its own rather than inheriting one from uniqueness.
  @@index([partRequestId])
  @@index([warehouseId])
  @@map("issued_items")
}

model PartReturnRequest {
  id                      String    @id @default(cuid())
  tenantId                String
  partRequestId           String    @unique
  quantity                Int
  reason                  String?
  requestedById           String
  createdAt               DateTime  @default(now())
  resolvedAt              DateTime?
  resolvedById            String?
  // The warehouse requestReturn() opened the RETURN_PENDING movement
  // against. Read back by completeReturn()/rejectReturn() to reverse
  // that SAME movement -- a caller-supplied warehouseId at accept time
  // is a legitimate choice of where the part physically lands on the
  // shelf, but it is never the right choice for which warehouse's
  // returnPendingQty gets decremented; those are two different
  // questions a single parameter cannot safely answer both of.
  warehouseId             String
  // The inventory manager's open question, set by Request Clarification
  // and cleared the moment the technician replies or the request is
  // finally accepted/rejected -- null means there is nothing outstanding
  // to ask the technician, whether because nobody asked or because the
  // loop already closed.
  clarificationQuestion   String?
  // When the question was asked. Kept even after `clarificationQuestion`
  // is cleared, because "the store asked something and the technician
  // answered" is a real pair of events in the job's history, and
  // nulling the question would otherwise erase the first half of it.
  clarificationAskedAt    DateTime?
  // When the technician answered it. The pair is what lets the journey
  // show a clarification CYCLE rather than a single undated fact.
  clarificationAnsweredAt DateTime?

  partRequest PartRequest @relation(fields: [partRequestId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("part_return_requests")
}

// Append-only ledger. before/after quantities captured on every row --
// this was one of the few things the old build got right; keeping it.
model StockMovement {
  id              String            @id @default(cuid())
  tenantId        String
  inventoryItemId String
  warehouseId     String
  type            StockMovementType
  quantity        Int
  beforeQty       Int
  afterQty        Int
  referenceType   String?
  referenceId     String?
  actorId         String
  createdAt       DateTime          @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([tenantId, inventoryItemId])
  @@index([warehouseId])
  @@map("stock_movements")
}

model InventoryTransfer {
  id                String         @id @default(cuid())
  tenantId          String
  inventoryItemId   String
  sourceWarehouseId String
  destWarehouseId   String
  quantity          Int
  status            TransferStatus @default(REQUESTED)
  requestedById     String
  createdAt         DateTime       @default(now())
  receivedAt        DateTime?

  sourceWarehouse Warehouse @relation("TransferSource", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destWarehouse   Warehouse @relation("TransferDestination", fields: [destWarehouseId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@map("inventory_transfers")
}

model SupplierOrder {
  id              String              @id @default(cuid())
  tenantId        String
  inventoryItemId String
  warehouseId     String
  quantity        Int
  supplier        String?
  status          SupplierOrderStatus @default(REQUESTED)
  requestedById   String
  createdAt       DateTime            @default(now())
  receivedAt      DateTime?

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@map("supplier_orders")
}

// ============================================================================
// FINANCE
// ============================================================================

model PriceCatalogEntry {
  id            String    @id @default(cuid())
  tenantId      String
  itemKey       String
  itemType      String
  unitPrice     Decimal   @db.Decimal(12, 2)
  laborPrice    Decimal?  @db.Decimal(12, 2)
  isActive      Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  @@index([tenantId, itemKey, effectiveFrom])
  @@map("price_catalog_entries")
}

model Quotation {
  id          String          @id @default(cuid())
  tenantId    String
  workOrderId String          @unique
  status      QuotationStatus @default(DRAFT)
  createdAt   DateTime        @default(now())

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrder WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  items     QuotationItem[]

  @@index([tenantId])
  @@map("quotations")
}

model QuotationItem {
  id            String   @id @default(cuid())
  tenantId      String
  quotationId   String
  name          String
  itemType      String
  quantity      Int      @default(1)
  unitPrice     Decimal  @db.Decimal(12, 2)
  laborPrice    Decimal  @default(0) @db.Decimal(12, 2)
  approvedPrice Decimal? @db.Decimal(12, 2)
  priceLocked   Boolean  @default(false)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

// The live, editable running total for a Work Order in progress.
model RunningInvoice {
  id          String   @id @default(cuid())
  tenantId    String
  workOrderId String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrder WorkOrder            @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  lines     RunningInvoiceLine[]

  @@map("running_invoices")
}

model RunningInvoiceLine {
  id               String   @id @default(cuid())
  tenantId         String
  runningInvoiceId String
  name             String
  itemType         String
  quantity         Int      @default(1)
  unitPrice        Decimal  @db.Decimal(12, 2)
  laborPrice       Decimal  @default(0) @db.Decimal(12, 2)
  total            Decimal  @db.Decimal(12, 2)
  isFinalized      Boolean  @default(false)
  // Where this line came from in Operations, matching ChargeableWorkItem's
  // sourceType/sourceId in packages/shared/src/contracts/cross-system.ts.
  // Null for a line somebody typed in by hand, which is most of them.
  //
  // This exists so Finance can fold an operational fact (a part left the
  // store for this job) into the running total EXACTLY ONCE, without
  // reaching into Inventory's tables to ask what it already billed.
  sourceType       String?
  sourceId         String?
  addedById        String
  createdAt        DateTime @default(now())

  runningInvoice RunningInvoice @relation(fields: [runningInvoiceId], references: [id], onDelete: Cascade)

  // One line per operational source, per running invoice. The uniqueness
  // is what makes the reconciliation idempotent rather than additive --
  // without it, every call to jobTotal() would bill the part again.
  @@unique([runningInvoiceId, sourceType, sourceId])
  @@index([runningInvoiceId])
  @@map("running_invoice_lines")
}

// Immutable once issued. lockedUnitPrice/lockedLaborPrice on each line are
// snapshotted at issue time -- see InvoiceLine below.
model Invoice {
  id               String        @id @default(cuid())
  tenantId         String
  branchId         String?
  workOrderId      String        @unique
  invoiceNumber    String
  status           InvoiceStatus @default(ISSUED)
  subtotal         Decimal       @db.Decimal(12, 2)
  discount         Decimal       @default(0) @db.Decimal(12, 2)
  tax              Decimal       @default(0) @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  paid             Decimal       @default(0) @db.Decimal(12, 2)
  balance          Decimal       @db.Decimal(12, 2)
  locked           Boolean       @default(true)
  immutableVersion Int           @default(1)
  issuedById       String
  issuedAt         DateTime      @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  workOrder       WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  lines           InvoiceLine[]
  payments        Payment[]
  refunds         RefundRequest[]
  creditNotes     CreditNote[]
  billingDocument BillingDocument?

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([tenantId, branchId, issuedAt])
  @@map("invoices")
}

model InvoiceLine {
  id               String  @id @default(cuid())
  tenantId         String
  invoiceId        String
  name             String
  itemType         String
  quantity         Int     @default(1)
  lockedUnitPrice  Decimal @db.Decimal(12, 2)
  lockedLaborPrice Decimal @default(0) @db.Decimal(12, 2)
  total            Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model InvoiceSequence {
  tenantId   String @id
  lastNumber Int    @default(0)

  @@map("invoice_sequences")
}

model Payment {
  id                    String        @id @default(cuid())
  tenantId              String
  invoiceId             String
  amount                Decimal       @db.Decimal(12, 2)
  method                PaymentMethod
  status                PaymentStatus @default(CONFIRMED)
  idempotencyKey        String        @unique
  providerTransactionId String?
  recordedById          String
  createdAt             DateTime      @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([tenantId, invoiceId])
  @@map("payments")
}

model DiscountRequest {
  id            String                @id @default(cuid())
  tenantId      String
  workOrderId   String
  amount        Decimal               @db.Decimal(12, 2)
  reason        String
  status        DiscountRequestStatus @default(PENDING)
  requestedById String
  decidedById   String?
  createdAt     DateTime              @default(now())
  decidedAt     DateTime?

  @@index([tenantId, status])
  @@map("discount_requests")
}

model RefundRequest {
  id             String               @id @default(cuid())
  tenantId       String
  invoiceId      String
  amount         Decimal              @db.Decimal(12, 2)
  reason         String
  // Phase 19.C -- a routine reversal and remediation of a disputed or
  // fraudulent charge carry different audit, reporting, and potential
  // legal-disclosure weight; today's `reason` free-text field cannot be
  // relied on to distinguish them at scale.
  reasonCategory RefundReasonCategory @default(ROUTINE)
  status         RefundRequestStatus  @default(PENDING)
  requestedById  String
  decidedById    String?
  createdAt      DateTime             @default(now())
  decidedAt      DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@map("refund_requests")
}

// A Billing artifact, not a Finance one -- it has its own sequential
// number (CreditNoteSequence, the same atomic-upsert pattern as
// InvoiceSequence) and corrects a BillingDocument, not an Invoice
// directly. Phase 8 created this table and never wrote it; Phase 9 wires
// it to the refund approval flow.
model CreditNote {
  id                String   @id @default(cuid())
  tenantId          String
  invoiceId         String
  billingDocumentId String?
  creditNoteNumber  String?
  amount            Decimal  @db.Decimal(12, 2)
  reason            String
  issuedById        String
  createdAt         DateTime @default(now())

  invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  billingDocument BillingDocument? @relation(fields: [billingDocumentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, creditNoteNumber])
  @@index([tenantId, invoiceId])
  @@map("credit_notes")
}

model CreditNoteSequence {
  tenantId   String @id
  lastNumber Int    @default(0)

  @@map("credit_note_sequences")
}

enum BillingDocumentStatus {
  PENDING
  CLEARED
  REJECTED
  CLEARANCE_FAILED
}

// The legal document, distinct from Invoice (Finance's own settlement
// record -- running balance, paid, numbering stay there). Billing gets
// its own row, its own lifecycle, and an immutable rendered snapshot
// captured at the moment the invoice-issued contract was handed to it,
// never re-read from Invoice later -- the same reason
// InvoiceLine.lockedUnitPrice exists, applied one level up.
model BillingDocument {
  id                 String                @id @default(cuid())
  tenantId           String
  invoiceId          String                @unique
  documentNumber     String
  adapterName        String
  status             BillingDocumentStatus @default(PENDING)
  qrPayload          String?
  clearanceReference String?
  snapshot           Json
  createdAt          DateTime              @default(now())

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  creditNotes CreditNote[]

  @@unique([tenantId, documentNumber])
  @@map("billing_documents")
}

model FinanceConfiguration {
  tenantId                  String          @id
  // External Billing Mode: MOP owns pricing, payments and balances while
  // legal invoices are issued from separate accounting software. The
  // reference is recorded so delivery can still be gated on an invoice
  // existing, even though MOP did not produce it.
  externalBillingEnabled    Boolean         @default(false)
  externalInvoiceReference  String?
  // Set when this tenant's country has no BillingCountryAdapter beyond
  // the generic one and External Billing Mode is off -- operationally
  // fine, legally insufficient the moment an invoice is actually issued.
  // Visibility only in Phase 9: this flags the situation everywhere it
  // matters (the Workshops list drawer) without hard-blocking issuance,
  // because MOP is not the tenant's lawyer and a workshop may have its
  // own arrangement. See docs/phases/PHASE_9.md section 6.
  compliantBlocked          Boolean         @default(false)
  technicianPriceVisible    Boolean         @default(false)
  customerInvoiceVisible    Boolean         @default(true)
  discountApprovalThreshold Decimal         @default(0) @db.Decimal(12, 2)
  maxDiscountPercent        Decimal         @default(0) @db.Decimal(5, 2)
  maxBranchDiscountPercent  Decimal         @default(0) @db.Decimal(5, 2)
  depositRequired           Boolean         @default(false)
  depositPercent            Decimal         @default(0) @db.Decimal(5, 2)
  taxRatePercent            Decimal         @default(0) @db.Decimal(5, 2)
  taxInclusive              Boolean         @default(true)
  invoiceNumberPrefix       String          @default("INV")
  defaultDueInDays          Int             @default(0)
  allowUnpaidDelivery       Boolean         @default(false)
  allowPartialPaidDelivery  Boolean         @default(false)
  paymentMethods            PaymentMethod[]
  invoiceTerms              String?
  updatedAt                 DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("finance_configuration")
}

// ============================================================================
// CUSTOMER-FACING
// ============================================================================

model CustomerDecisionRequest {
  id              String                 @id @default(cuid())
  tenantId        String
  workOrderId     String
  customerId      String
  status          CustomerDecisionStatus @default(PENDING)
  secureToken     String                 @unique
  whatsappMessage String?
  sentAt          DateTime?
  // When the customer actually OPENED the link. The `VIEWED` status
  // already recorded that they had, but not when -- so the journey could
  // say "the customer has seen it" and not "since when", which is the
  // half a branch manager chasing an answer actually needs. Null means
  // they have not opened it, never "we did not record it".
  viewedAt        DateTime?
  respondedAt     DateTime?
  expiresAt       DateTime?
  createdById     String
  createdAt       DateTime               @default(now())

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrder WorkOrder              @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  customer  Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items     CustomerDecisionItem[]

  @@index([tenantId, status])
  @@index([workOrderId])
  @@map("customer_decision_requests")
}

model CustomerDecisionItem {
  id                  String                       @id @default(cuid())
  tenantId            String
  decisionRequestId   String
  // The finding this recommendation answers.
  //
  // Inspection -> Fault -> Recommendation -> Task -> Invoice is the chain
  // history has to walk to say "we found this, we proposed this, you
  // agreed to this, we did this, we charged this". `Fault.inspectionId`
  // and `Task.decisionItemId` already carried their links; this was the
  // one missing hop, and without it the connection between a finding and
  // the recommendation made about it was a comparison of free text --
  // exactly the silent lie Task.decisionItemId's own comment was written
  // to prevent, one step earlier in the same chain.
  //
  // Null for a recommendation that came from somewhere other than a
  // recorded finding, which is legitimate: a customer can ask for a
  // service nobody diagnosed.
  faultId             String?
  // Which catalogued service this recommendation proposes.
  //
  // The same stable business key `Task.serviceKey` uses, and stored for
  // the same reason: the catalogue is effective-dated, so a row id would
  // pin a version of a price rather than the identity of a service. With
  // it, "the customer approved THIS service" survives into the task that
  // performs it. Null for a proposal the catalogue does not carry --
  // `price`/`laborPrice`/`total` remain the frozen commercial truth
  // either way, and are never re-read from the catalogue.
  serviceKey          String?
  name                String
  explanation         String
  importance          SeverityLevel
  price               Decimal                      @db.Decimal(12, 2)
  laborPrice          Decimal                      @default(0) @db.Decimal(12, 2)
  total               Decimal                      @db.Decimal(12, 2)
  decision            CustomerDecisionItemDecision @default(PENDING)
  warningAcknowledged Boolean                      @default(false)
  note                String?
  decidedAt           DateTime?

  decisionRequest CustomerDecisionRequest @relation(fields: [decisionRequestId], references: [id], onDelete: Cascade)
  // The work planned to carry this recommendation out. Empty for an item
  // nobody has planned yet -- which history reports as "approved, no work
  // linked" rather than guessing either way.
  tasks           Task[]
  // SetNull: a deleted finding must not delete the record of what the
  // customer was told and what they agreed to.
  fault           Fault?                  @relation(fields: [faultId], references: [id], onDelete: SetNull)

  @@index([decisionRequestId])
  // Answers "what was recommended about this finding" without a scan --
  // the read the recommendation-outcome projection makes per finding.
  @@index([faultId])
  @@map("customer_decision_items")
}

// Customer-visible activity feed, populated exclusively through the
// CustomerSafeProjection service (see Phase 1) -- nothing writes here
// directly with raw internal text.
model CustomerTimelineEvent {
  id          String   @id @default(cuid())
  tenantId    String
  workOrderId String?
  customerId  String
  message     String
  eventKey    String
  createdAt   DateTime @default(now())

  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("customer_timeline_events")
}

// Sanitized service-history snapshot, scoped per ownership period so a new
// owner never sees a previous owner's entries. Built with a real read
// path from day one this time (the old model was seeded but never queried).
model SafeTechnicalHistory {
  id              String   @id @default(cuid())
  tenantId        String
  assetId         String
  workOrderId     String?
  ownerCustomerId String
  summary         String
  serviceDate     DateTime
  createdAt       DateTime @default(now())

  asset     Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([assetId, ownerCustomerId])
  @@map("safe_technical_history")
}

// ============================================================================
// TENANT CONFIGURATION (BUILDER) -- single source of truth
//
// This replaces the old build's two disconnected tables (a Builder-editor
// table and a separately-read runtime table). EffectiveAccessResolver and
// the Owner-facing Builder UI both read and write this SAME row -- there
// is no second copy anywhere.
// ============================================================================

model TenantConfiguration {
  tenantId         String   @id
  theme            Json
  pageLayouts      Json
  roleExperience   Json
  workflowPolicy   Json
  featureFlags     Json
  enabledModules   String[]
  enabledFeatures  String[]
  forms            Json
  messageTemplates Json
  draftVersion     Int      @default(1)
  publishedVersion Int      @default(1)
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_configuration")
}

// Mirrors CapabilityStatus in packages/shared/src/capabilities/types.ts.
// EXTERNAL is the load-bearing one: a workshop that issues legal invoices
// from separate accounting software is EXTERNAL for billing, not DISABLED
// -- the business function still happens, MOP just does not perform it, so
// an external reference must still be recorded and may still gate delivery.
enum TenantCapabilityStatus {
  ENABLED
  DISABLED
  READ_ONLY
  EXTERNAL
  LOCKED
}

// Where a capability's current state came from. Determines who may change
// it: a platform-sourced lock is not the owner's to undo.
enum CapabilitySource {
  PLATFORM
  PLAN
  OWNER_CONFIGURATION
  MIGRATION
  SYSTEM
}

// Deliberately narrower than CapabilitySource: no OWNER_CONFIGURATION
// value yet, because whether an Owner may ever configure a policy is the
// exact question PHASE_21.md S8.C leaves OPEN. Adding the value later is
// a additive migration; adding it now would be the schema quietly taking
// a side on a question this phase was explicit about not deciding.
enum PolicySource {
  PLATFORM
  DEFAULT
  MIGRATION
  SYSTEM
}

// A workshop's shape, over time.
//
// Time-ranged rather than a single current value, because history has to
// be interpretable under the rules that were in force when it happened. A
// work order created in 2026 while Inventory was disabled has no part
// requests; read under 2027's capabilities it looks corrupt -- missing
// stock movements, missing part lifecycle -- when in fact parts were
// handled externally and the record is perfectly correct.
//
// `effectiveTo` null means "current". Exactly one open row per
// (tenant, capability) is the invariant; superseding a capability closes
// the old row and opens a new one in the same transaction, so the two are
// never both open and never both closed.
model TenantCapability {
  id               String                 @id @default(cuid())
  tenantId         String
  capabilityKey    String
  status           TenantCapabilityStatus
  effectiveFrom    DateTime               @default(now())
  effectiveTo      DateTime?
  source           CapabilitySource
  // Set by Platform Super Admin. The Owner cannot override it, matching
  // the resolver's rule that lower layers never beat higher ones.
  lockedByPlatform Boolean                @default(false)
  configuredBy     String?
  reason           String?
  createdAt        DateTime               @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // The hot path: "this tenant's open rows". Partial-unique on the open
  // row would be better still, but Prisma cannot express a filtered index,
  // so the single-open-row invariant is enforced in the service layer and
  // asserted by tests.
  @@index([tenantId, effectiveTo])
  @@index([tenantId, capabilityKey, effectiveFrom])
  @@map("tenant_capabilities")
}

// A workshop's answer to a policy question, over time -- the third axis
// alongside TenantCapability (does the step exist) and specialization
// (what is it called). Phase 21 (docs/phases/PHASE_21.md) settled the
// model before this table was written: `POLICY_REGISTRY` in
// @mop/shared/policies owns the typed options and the default for each
// key; this table only ever stores the CHOSEN option key as a string,
// exactly like TenantCapability.capabilityKey -- the enum of legal
// values lives in code, where it can be type-checked, not in a database
// CHECK constraint that drifts from it.
//
// Time-ranged for the same reason TenantCapability is: a work order
// invoiced in 2026 must be read against the payment policy in force in
// 2026, not whatever the workshop has since changed it to.
//
// Absent row means "use POLICY_REGISTRY's declared default for this
// key" -- deliberately the same convention as an absent TenantCapability
// row meaning ENABLED, so a freshly-provisioned workshop with zero rows
// here is a complete, correctly-configured workshop, not a broken one.
//
// Who may write this row (Owner vs Platform Super Admin) is an OPEN
// product decision as of Phase 21's review (see PHASE_21.md S8.C) --
// deliberately not encoded here. `source`/`configuredBy` record WHO
// changed it, same as TenantCapability, without this schema taking a
// position on who is allowed to.
model WorkshopPolicy {
  id            String       @id @default(cuid())
  tenantId      String
  policyKey     String
  value         String
  effectiveFrom DateTime     @default(now())
  effectiveTo   DateTime?
  source        PolicySource
  configuredBy  String?
  reason        String?
  createdAt     DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Same access pattern as TenantCapability: "this tenant's open rows".
  // Single-open-row-per-(tenant,policyKey) is a service-layer invariant,
  // asserted by tests, for the same reason noted on TenantCapability --
  // Prisma cannot express a filtered unique index.
  @@index([tenantId, effectiveTo])
  @@index([tenantId, policyKey, effectiveFrom])
  @@map("workshop_policies")
}

model TenantConfigurationVersion {
  id            String         @id @default(cuid())
  tenantId      String
  version       Int
  snapshot      Json
  riskLevel     AuditRiskLevel
  publishedById String
  publishedAt   DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, version])
  @@map("tenant_configuration_versions")
}

// Owner's Messages & Templates page (docs/detailed-specs/tenant-owner.md).
// Deliberately a separate model from TenantConfiguration.messageTemplates
// (the Builder/Super-Admin-side JSON blob written empty at tenant
// creation and read by nothing) -- that column is Builder Control's
// starting-shape config, a different subsystem at a different authority
// level; conflating the two would let an Owner's published template
// silently overwrite, or be overwritten by, Super Admin's Builder draft.
//
// Never mutated after publish: every edit inserts a new, higher-version
// row rather than updating the current one, mirroring WorkshopPolicy's
// time-ranged discipline. This is what "a later template edit doesn't
// retroactively change what a past audit entry shows was actually sent"
// requires -- an audit entry can record a `templateVersion` and that
// version's exact body stays readable forever, never rewritten in place.
model MessageTemplate {
  id            String   @id @default(cuid())
  tenantId      String
  templateKey   String
  body          String
  version       Int
  publishedById String
  publishedAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, templateKey, version])
  @@index([tenantId, templateKey])
  @@map("message_templates")
}

// Owner's Forms & Fields page (docs/detailed-specs/tenant-owner.md).
// Additive only, by design: adding a row here can never break an
// existing record, because nothing reads this table to decide how to
// interpret already-stored data -- every consuming form's own fields
// column (see e.g. Inspection.fields) stores whatever was captured under
// whatever definition existed at fill time, and archiving a definition
// here never touches those already-stored values.
model CustomFieldDefinition {
  id              String         @id @default(cuid())
  tenantId        String
  formKey         String
  fieldKey        String
  label           String
  fieldType       String
  // For fieldType = SELECT: array of { key, label }. Null otherwise.
  options         Json?
  // Empty array means "all categories this workshop operates."
  categoryScope   CategoryCode[]
  // Which staff roles fill this field in. Empty means any role that can
  // reach the form at all.
  roleScope       String[]
  customerVisible Boolean        @default(false)
  reportable      Boolean        @default(false)
  required        Boolean        @default(false)
  order           Int            @default(0)
  // Archived, never deleted -- past records that captured a value under
  // this definition keep showing it, tagged (archived field). Restoring
  // un-archives it back into the live form at the same `order`.
  isArchived      Boolean        @default(false)
  createdById     String
  createdAt       DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, formKey, fieldKey])
  @@index([tenantId, formKey, isArchived])
  @@map("custom_field_definitions")
}

// ============================================================================
// AUDIT & OPERATIONS EVENTS
// ============================================================================

// The only table any audit write may target -- enforced by module
// encapsulation in apps/api (Phase 1), not just convention.
model AuditLog {
  id         String         @id @default(cuid())
  tenantId   String?
  actorId    String
  actorType  AuditActorType
  actorName  String
  targetType String
  targetId   String
  action     String
  before     Json?
  after      Json?
  reason     String?
  riskLevel  AuditRiskLevel
  createdAt  DateTime       @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// Replay/debug log for the centralized operation-event pipeline. Every
// significant action emits one row here before fanning out to workflow
// status, notifications, audit, and customer-safe projection.
model OperationEvent {
  id          String         @id @default(cuid())
  tenantId    String
  eventKey    String
  payload     Json
  actorId     String
  actorType   AuditActorType
  workOrderId String?
  branchId    String?
  createdAt   DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, eventKey, createdAt])
  @@index([tenantId, branchId, eventKey, createdAt])
  @@index([tenantId, workOrderId, createdAt])
  @@map("operation_events")
}

// ============================================================================
// PLATFORM
// ============================================================================

model PlatformLiveViewSession {
  id                String    @id @default(cuid())
  platformAccountId String
  tenantId          String
  roleViewed        StaffRole
  personaViewed     String?
  mode              String    @default("read_only")
  startedAt         DateTime  @default(now())
  endedAt           DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startedAt])
  @@map("platform_live_view_sessions")
}

/// A person's response to a detected workflow issue.
///
/// Deliberately does NOT store the issues themselves. Integrity issues are
/// derived facts -- recomputed from the records on every scan -- and
/// persisting them would create a second copy that drifts from the data it
/// was derived from, which is the exact failure Workflow Health exists to
/// detect. What cannot be recomputed is what a human decided about one, so
/// that is the only thing kept here.
///
/// Keyed by a deterministic fingerprint (`type:entityType:entityId`) so the
/// same underlying problem is the same row across scans, and an issue that
/// stops being detected is resolved by definition rather than by anyone
/// remembering to close it.
model WorkflowIssueAcknowledgement {
  id          String              @id @default(cuid())
  tenantId    String
  /// `${type}:${entityType}:${entityId}` -- stable across scans.
  fingerprint String
  issueType   String
  entityType  String
  entityId    String
  status      WorkflowIssueStatus @default(ACKNOWLEDGED)
  /// Why it was acknowledged or escalated. Required by the service, not the schema.
  note        String?
  actorId     String
  actorName   String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fingerprint])
  @@index([tenantId, status])
  @@map("workflow_issue_acknowledgements")
}

enum WorkflowIssueStatus {
  ACKNOWLEDGED
  INVESTIGATING
  ESCALATED
}
