{
  "name": "@mop/database",
  "version": "0.1.0",
  "private": true,
  "main": "./generated/client/index.js",
  "types": "./generated/client/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "node ../../tools/with-env.mjs prisma migrate dev",
    "migrate:deploy": "node ../../tools/with-env.mjs prisma migrate deploy",
    "studio": "node ../../tools/with-env.mjs prisma studio",
    "seed": "node ../../tools/with-env.mjs tsx prisma/seed.ts",
    "reset": "node ../../tools/with-env.mjs prisma migrate reset --force",
    "test:prepare": "node ../../tools/with-env.mjs --mop-env .env.test prisma migrate deploy",
    "migrate:create": "node ../../tools/with-env.mjs prisma migrate dev --name",
    "validate": "node ../../tools/with-env.mjs prisma validate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
