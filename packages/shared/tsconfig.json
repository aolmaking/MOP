{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  // Specs are run by ts-jest straight from src; keeping them out of the
  // build means dist stays shippable and the published types don't drag
  // in @types/jest.
  "exclude": ["src/**/*.spec.ts"]
}
