{
  "name": "mop-product-platform-v4",
  "version": "4.0.0",
  "private": true,
  "description": "MOP production SaaS platform monorepo: Angular web, NestJS API, Prisma database, shared contracts.",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @mop/api --filter @mop/web dev",
    "dev:web": "pnpm --filter @mop/web dev",
    "dev:api": "pnpm --filter @mop/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @mop/database prisma generate",
    "db:push": "pnpm --filter @mop/database prisma db push",
    "db:doctor": "node tools/db-doctor.mjs",
    "db:reset-local": "pnpm db:generate && pnpm --filter @mop/database prisma db push --force-reset && pnpm db:doctor && pnpm db:seed && pnpm db:demo-logins",
    "db:migrate": "pnpm --filter @mop/database prisma migrate dev",
    "db:seed": "pnpm db:generate && pnpm --filter @mop/database prisma db seed",
    "db:demo-logins": "node tools/update-demo-role-logins.mjs",
    "validate:structure": "node tools/validate-structure.mjs",
    "validate:pre-v6": "node tools/validate-pre-v6-stabilization.mjs",
    "validate:v7-builder": "node tools/validate-v7-builder-foundation.mjs",
    "validate:v7-final-gate": "node tools/validate-v7-final-gate.mjs",
    "validate:v8-platform": "node tools/validate-v8-platform-command-center.mjs",
    "validate:v7-v8-final-gate": "node tools/validate-v7-v8-final-gate.mjs",
    "validate:v9-reporting": "node tools/validate-v9-reporting-configuration.mjs",
    "validate:v9-final-gate": "node tools/validate-v9-final-gate.mjs",
    "validate:v10-operations": "node tools/validate-v10-cross-role-operations.mjs",
    "validate:v11-finance": "node tools/validate-v11-financial-operations.mjs",
    "validate:auth-foundation": "node tools/validate-auth-foundation.mjs",
    "validate:network": "node tools/validate-network-wiring.mjs",
    "validate:release-candidate": "node tools/validate-release-candidate.mjs",
    "validate:english-only": "node tools/validate-english-only.mjs",
    "validate:production-hardening": "node tools/validate-production-hardening.mjs"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.9.3"
  }
}
